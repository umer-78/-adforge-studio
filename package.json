{
  "name": "adforge-studio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @adforge/web --filter @adforge/worker dev",
    "dev:web": "pnpm --filter @adforge/web dev",
    "dev:worker": "pnpm --filter @adforge/worker dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @adforge/web test:e2e",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > packages/core/src/db/database.types.ts",
    "assets:generate": "pnpm --filter @adforge/worker assets:generate"
  }
}
