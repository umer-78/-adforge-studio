# AdForge Studio environment variables.
#
# Local development: copy this file to .env at the repository root and fill it in.
# Production: add the same names in Vercel (the website) and Railway (the worker).
# [web] marks a value only the website reads, [worker] one only the worker reads; everything else
# is read by both and must hold the same value in both places. See docs/deploy.md.
# Every provider key is optional: features that need a missing key say so in the studio.

# ----------------------------------------------------------------------------- App
# The site's public address. Links in emails and provider webhooks point here. On Vercel it
# defaults to the project's production domain; set it on the worker so webhooks reach the site.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails allowed to use the studio. Empty lets anyone who signs up in.
APP_OWNER_EMAILS=
# 32 random bytes as base64 (openssl rand -base64 32, or Settings > Providers > Copy a new key).
# Encrypts provider keys and social account tokens. Changing it makes saved ones unreadable;
# to rotate, move the old value to APP_ENCRYPTION_KEY_PREVIOUS.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_PREVIOUS=
# [web] OAuth sign-in buttons, comma-separated: google, github, apple, azure, linkedin_oidc.
# Turn each one on in Supabase > Authentication > Sign In / Providers first.
NEXT_PUBLIC_AUTH_PROVIDERS=
# [web] Public contact address shown on the privacy, terms and data deletion pages. Platform app
# reviews (Meta, Google, TikTok) expect one. Empty points visitors to the self-serve tools instead.
NEXT_PUBLIC_CONTACT_EMAIL=

# ------------------------------------------------------------------------ Supabase
# Supabase > Project Settings > API Keys. The secret key never goes to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Largest upload with Supabase Storage, in MB (the free plan allows 50).
SUPABASE_MAX_FILE_MB=50

# ------------------------------------------------------------- Storage (optional)
# s3 stores files in any S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3) instead of
# Supabase Storage, and allows uploads up to 5 GB.
STORAGE_DRIVER=supabase
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------- Video streaming (optional)
# Mux plays uploads as adaptive streams. Without it videos play straight from storage.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# ------------------------------------------------------------------ AI providers
# Each workspace can also add its own keys in Settings > Providers; those win over these.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_FAST_MODEL=claude-sonnet-5-5
ANTHROPIC_SERVER_FALLBACKS=true
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
OPENAI_API_KEY=
FAL_KEY=
FAL_WEBHOOKS=true
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
ELEVENLABS_API_KEY=
# What your ElevenLabs plan charges, in USD, so cost estimates match your bill.
ELEVENLABS_USD_PER_1K_CHARS=0.22
ELEVENLABS_MUSIC_USD_PER_MIN=0.8
ELEVENLABS_SFX_USD_PER_GEN=0.044
ELEVENLABS_STS_USD_PER_MIN=0.22
ELEVENLABS_ISOLATE_USD_PER_MIN=0.22
ELEVENLABS_STT_USD_PER_MIN=0.0067
ELEVENLABS_DUB_USD_PER_MIN=0.66
# auto, elevenlabs or openai.
TRANSCRIBE_PROVIDER=auto
# Tag, transcribe and index every upload when an LLM key is set.
AUTO_ANALYZE=true

# ------------------------------------------------------- Publishing and ads (optional)
# Each platform's developer app. Redirect URLs to register in the app:
#   publishing: <NEXT_PUBLIC_APP_URL>/api/social-accounts/callback/<platform>
#   ads:        <NEXT_PUBLIC_APP_URL>/api/ad-accounts/callback/<platform>
# Meta also asks for (see docs/deploy.md, Platform apps):
#   data deletion callback: <NEXT_PUBLIC_APP_URL>/api/meta/data-deletion
#   deauthorize callback:   <NEXT_PUBLIC_APP_URL>/api/meta/deauthorize
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_AD_LIBRARY_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202605
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
AYRSHARE_API_KEY=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=

# ------------------------------------------------------------------------ [worker]
WORKER_ID=worker-1
# Comma-separated pools to run (render, media, ai, network). Empty runs them all.
WORKER_POOLS=
# Health endpoint port; hosts that set PORT (Railway does) override it.
WORKER_PORT=8080
WORKER_TMP_DIR=.tmp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Chrome for rendering. Empty uses the Chrome Headless Shell that Remotion downloads.
REMOTION_CHROME_PATH=
# A pre-built composition bundle (folder or URL). The Docker image ships one.
REMOTION_SERVE_URL=
# Remotion is free for individuals and companies of up to three people; larger companies
# need a company license: https://www.remotion.dev/license
REMOTION_LICENSE_KEY=
# Chrome tabs per render. 0 sizes it from the CPUs and memory the worker may use.
RENDER_CONCURRENCY=0
LOG_LEVEL=info
