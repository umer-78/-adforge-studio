{
  "name": "@adforge/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "bundle:site": "tsx src/scripts/bundle-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:generate": "tsx --env-file-if-exists=../../.env src/scripts/generate-builtin-assets.ts",
    "smoke:render": "tsx src/scripts/render-smoke.ts"
  },
  "dependencies": {
    "@adforge/compositions": "workspace:*",
    "@adforge/core": "workspace:*",
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@fal-ai/client": "^1.10.1",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@supabase/supabase-js": "^2.118.0",
    "immer": "^11.2.9",
    "node-html-parser": "^9.0.5",
    "openai": "^7.45.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.539",
    "replicate": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
